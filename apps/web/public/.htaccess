# BUSINÚ · Apache (cPanel): rutas de la SPA y caché
Options -MultiViews
RewriteEngine On
RewriteBase /

# Si el archivo o la carpeta existen, se sirven tal cual
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás lo resuelve React Router
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # index.html nunca se guarda en caché: así siempre carga la versión nueva
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Los archivos con hash en el nombre no cambian nunca
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
</IfModule>
